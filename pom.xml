<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.hnp</groupId>
	<artifactId>file-management</artifactId>
	<version>1.6.0</version>
	<name>file-management</name>
	<description>file-management</description>
	<packaging>jar</packaging>

	<properties>
		<!-- The language level: compiled with -release 25, run on a JDK 25 (Temurin 25 LTS). Moved
		     from 21 in 1.4.0; nothing below pins a class-file version - Lombok 1.18.48 and Byte Buddy
		     1.18.11 (Mockito's) both read Java 25 classes. -->
		<java.version>25</java.version>
		<!-- Spring Boot 4.1.1 manages an older Lombok; 1.18.48 is the first with a JDK 25 javac
		     annotation processor. Kept explicit so a Boot upgrade cannot silently lower it. -->
		<lombok.version>1.18.48</lombok.version>
		<!-- Extra JVM options for the test run, appended by surefire below. Empty by default so that
		     -DargLine=... on the command line (SchemaDocumentationTest's write switch) still works. -->
		<argLine></argLine>
		<springdoc.version>3.1.0</springdoc.version>
		<tika.version>3.3.2</tika.version>
		<!-- Boot 3.2.1 pins Testcontainers 1.19.3, which predates Docker context support and
		     cannot find a Docker Desktop daemon that only exposes dockerDesktopLinuxEngine. -->
		<testcontainers.version>1.21.4</testcontainers.version>
		<!-- Spring Boot 4.1.1 manages Tomcat 11.0.24, which carries three CRITICAL advisories:
		     CVE-2026-65905 (DIGEST replay), CVE-2026-65182 (incorrect authorization) and
		     CVE-2026-68525 (FORM authentication authorization) - the last one applies directly,
		     this application authenticates with a form. All three are fixed in 11.0.25.
		     Drop this override once the managed version reaches 11.0.25 or later. -->
		<tomcat.version>11.0.25</tomcat.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- Testcontainers pulls commons-compress 1.24.0 transitively, which carries
			     CVE-2024-25710 and CVE-2024-26308 (both fixed in 1.26.0). Test scope only, so it
			     never ships - pinned anyway so a scan of this repository comes back clean. Neither
			     Spring Boot nor the Testcontainers BOM manages this artifact, so it needs an
			     explicit entry rather than a version property. -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-compress</artifactId>
				<version>1.28.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-ldap</artifactId>
		</dependency>
		<dependency>
			<groupId>org.thymeleaf.extras</groupId>
			<artifactId>thymeleaf-extras-springsecurity6</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
		  OpenAPI 3 and Swagger UI for the machine-facing API (roadmap 9.6). springdoc's major
		  version tracks Spring Boot's, so 3.x is the line that targets Boot 4.

		  Swagger UI is served from this dependency's own classpath, not fetched at runtime and not
		  resolved from /webjars/ at request time - which is the failure docs/ui.md records, where a
		  partly populated ~/.m2 served 404s for every asset. It works with no internet access.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!--
		  Content detection by magic bytes, for the "what is this file" probe on the content-kinds
		  settings page: an administrator hands it a sample and gets the media type and the first
		  bytes to define a new kind from. tika-core only - the parsers module is the heavy one and
		  nothing here needs it. Detection of an upload's kind stays with ContentTypes: the probe
		  suggests, the registry decides.
		-->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>${tika.version}</version>
		</dependency>

		<!--
		  Health and info endpoints (roadmap 9.5, closing issue 41). Only `health` and `info` are
		  exposed; see the management block in application.properties and the actuator security
		  chain in SecurityConfig for why each of those decisions is what it is.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Spring Boot 4 split its auto-configuration into per-technology modules. flyway-core is
		     only the library: without spring-boot-flyway the migrations never run, and Hibernate's
		     ddl-auto=validate then fails with "missing table". -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Boot 4 moved each test slice into its own module alongside its auto-configuration:
		     @DataJpaTest, @AutoConfigureTestDatabase and @AutoConfigureMockMvc each now live in a
		     technology-specific artifact and package. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jdbc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>mysql</artifactId>
			<scope>test</scope>
		</dependency>



	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<!-- Exposes each dependency's jar path as a property, for the -javaagent below. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>dependency-paths</id>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Mockito's inline mock maker attaches Byte Buddy as an agent. JDK 21+ warns when an
					     agent is loaded dynamically and will refuse it by default one day, so it is loaded
					     the supported way, on the command line. -->
					<argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar} ${argLine}</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- JDK 23 and later no longer run annotation processors found on the classpath
					     implicitly, so Lombok has to be declared as an explicit processor path or
					     none of the generated getters/setters exist. -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<!--
				  Two goals, both deliberate.

				  repackage turns target/file-management.jar into the executable "fat" jar: the
				  application, every dependency and the embedded Tomcat behind JarLauncher, so that
				  `java -jar` is the whole runtime and deployment copies one file. The parent POM
				  binds it by default; it is named here so that the intent survives a parent change
				  and so that nobody reads the absence as "a thin jar is fine".

				  build-info writes build-info.properties into the jar, which is what makes
				  /actuator/info answer with the version and build time instead of an empty object.
				  Without it, "which build is running?" can only be answered by looking at file
				  timestamps - a question deployment.md tells operators to ask after every upgrade.
				-->
				<executions>
					<execution>
						<id>repackage</id>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
