# Copy to .env beside compose.yaml and fill in. .env is never committed.

# Two physical disks for the two volume servers - each holds a full copy (replication 001).
VOLUME1_DIR=/srv/disk1/seaweedfs/volume1
VOLUME2_DIR=/srv/disk2/seaweedfs/volume2

# Small: the master's state, the filer database, the admin UI's settings, the worker's id.
MASTER_DIR=/srv/seaweedfs/master
FILER_DB_DIR=/srv/seaweedfs/filer-db
ADMIN_DIR=/srv/seaweedfs/admin
WORKER_DIR=/srv/seaweedfs/worker

# Passwords: long and random (openssl rand -base64 24).
FILER_DB_PASSWORD=
ADMIN_UI_PASSWORD=

# The size a volume grows to before a new one is started, in MB. A volume server has one slot per
# (free space / this), and the master grows 6 volumes at a time for replication 001 - 3 slots on
# each server - for every bucket (a collection) and once for the filer's own files. So each disk
# needs room for at least 6 x this; 30000 wants 180 GB or more. Smaller for a small test disk.
VOLUME_SIZE_LIMIT_MB=30000

# Where the S3 port listens on the host; 0.0.0.0 for every interface, or one address.
S3_BIND=0.0.0.0
