# Copy to .env beside compose.yaml and fill in. .env is never committed.
# Absolute paths on a real host; ./relative paths are resolved from this directory.

# The one data disk: every file is here, and only here (replication 000). RAID 1 underneath,
# and the scheduled mirror of README.md, "Backups".
VOLUME_DIR=/srv/data/seaweedfs/volume

# Small: the master's state, the filer database, the admin UI's settings, the worker's id.
MASTER_DIR=/srv/seaweedfs/master
FILER_DB_DIR=/srv/seaweedfs/filer-db
ADMIN_DIR=/srv/seaweedfs/admin
WORKER_DIR=/srv/seaweedfs/worker

# Passwords: long and random (openssl rand -base64 24).
FILER_DB_PASSWORD=
ADMIN_UI_PASSWORD=

# The size a volume grows to before the master starts another, in MB. The volume server has one
# slot per (free space / this), and the master creates 3 volumes at a time for each collection -
# once for the filer's own files and once for the bucket (compose.yaml, WEED_MASTER_VOLUME_GROWTH_COPY_1).
# So the disk needs room for 6 x this before the first file: 30000 wants 180 GB. On a smaller
# disk make it smaller (10000 for 60 GB, 1000 for a test), or new volumes cannot be created and
# every write fails with "No writable volumes".
VOLUME_SIZE_LIMIT_MB=30000

# Where the S3 port listens on the host; 0.0.0.0 for every interface, or one address.
S3_BIND=0.0.0.0
