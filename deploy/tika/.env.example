# Copied to .env (docker compose reads it). Nothing secret here; .env is still not committed, as
# each host has its own.

# The official image's tag: the Tika version and the image's own build number (apache/tika on
# Docker Hub). 4.x: JSON configuration (config/*.json), parsing in forked JVMs. The application's
# tika-core (pom.xml, detection only) stays 3.x until roadmap 11.1 - it talks to this server over
# HTTP, so the two versions are independent.
TIKA_VERSION=4.1.0-1

# Where the two servers listen on the host. 127.0.0.1 to try them on this machine; the host's
# private address when the application runs elsewhere - and then the firewall lets the
# application's host alone through (README.md, "Security").
TIKA_BIND=127.0.0.1
TIKA_TEXT_PORT=9998
TIKA_OCR_PORT=9999

# What each may take. The text lane needs memory more than CPU; the OCR lane CPU above all.
# Tika sizes its forked JVMs' heap from the container's memory by itself; config/*.json's
# pipes.numClients is the number of forks - one per 2 CPUs beyond the server's own 2.
TIKA_TEXT_CPUS=2
TIKA_TEXT_MEMORY=4g
TIKA_OCR_CPUS=2
TIKA_OCR_MEMORY=6g
