<?xml version="1.0" encoding="UTF-8"?>
<!--
  The text lane (tika-text): documents with text in them - Word, Excel, PowerPoint, OpenDocument,
  RTF, text PDFs. The image has no Tesseract, and OCR is switched off besides: a scanned page here
  yields no text, and is the OCR lane's to read.
-->
<properties>
  <parsers>
    <parser class="org.apache.tika.parser.DefaultParser">
      <parser-exclude class="org.apache.tika.parser.pdf.PDFParser"/>
    </parser>
    <parser class="org.apache.tika.parser.pdf.PDFParser">
      <params>
        <param name="ocrStrategy" type="string">no_ocr</param>
      </params>
    </parser>
  </parsers>
  <server>
    <params>
      <taskTimeoutMillis>300000</taskTimeoutMillis>
      <forkedJvmArgs>
        <arg>-Xms512m</arg>
        <arg>-Xmx2g</arg>
        <arg>-XX:+ExitOnOutOfMemoryError</arg>
      </forkedJvmArgs>
      <returnStackTrace>false</returnStackTrace>
    </params>
  </server>
</properties>
